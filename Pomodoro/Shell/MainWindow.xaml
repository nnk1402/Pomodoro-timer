<Window x:Class="Pomodoro.Shell.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:theme="clr-namespace:Pomodoro.Themes" xmlns:controls="clr-namespace:Pomodoro.Features.Timer.Controls" xmlns:todo="clr-namespace:Pomodoro.Features.Todo" xmlns:background="clr-namespace:Pomodoro.Features.Background"
 xmlns:music="clr-namespace:Pomodoro.Features.Music"
 Title="Pomodoro NNK1402" Width="1120" Height="800" MinWidth="820" MinHeight="700" WindowStartupLocation="CenterScreen" WindowState="Maximized"
 Background="{DynamicResource CanvasBrush}" FontFamily="Segoe UI" FontSize="14" PreviewKeyDown="Window_PreviewKeyDown" theme:KeyboardFocusFeedback.Enabled="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><theme:ThemeResources WallpaperAware="True"/></ResourceDictionary.MergedDictionaries>
            <!-- These three modes share one moving selection background. -->
            <Style x:Key="SlidingModeButton" TargetType="RadioButton" BasedOn="{StaticResource ModeButton}">
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Chrome" Background="Transparent" CornerRadius="10" Padding="{TemplateBinding Padding}" BorderThickness="2" BorderBrush="Transparent">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBrush}"/><Setter Property="theme:WallpaperText.SuppressShadow" Value="True"/></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{DynamicResource AccentInkBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="theme:WallpaperText.SuppressShadow" Value="True"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value></Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid SizeChanged="BackgroundLayout_SizeChanged">
        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid x:Name="WallpaperViewport" Grid.ColumnSpan="2" Background="Transparent" ClipToBounds="True" IsHitTestVisible="False">
            <Image x:Name="WallpaperImage" Stretch="UniformToFill"/>
            <Rectangle x:Name="WallpaperShade" Fill="Black" Opacity="0"/>
        </Grid>
        <Border Grid.Column="1" Background="{DynamicResource ContentBackdropBrush}"/>
        <!-- Sample the rendered wallpaper only; text and controls stay outside the blur. -->
        <Grid Grid.Column="0" ClipToBounds="True" IsHitTestVisible="False">
            <background:WallpaperBackdrop Source="{Binding ElementName=WallpaperViewport}"/>
        </Grid>
        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="20,30,20,24">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="10,0,0,40">
                    <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource AccentBrush}" Margin="0,0,10,0">
                        <Grid><Ellipse Stroke="{DynamicResource OnAccentBrush}" StrokeThickness="1.6" Width="19" Height="19"/><Path Data="M 17,10 L 17,17 L 22,17" Stroke="{DynamicResource OnAccentBrush}" StrokeThickness="1.6" StrokeLineJoin="Round"/></Grid>
                    </Border>
                    <TextBlock Text="Pomodoro" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Row="1">
                    <TextBlock Text="Không gian của bạn" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="16,0,0,14"/>
                    <Grid x:Name="ModeNavigation">
                        <Border x:Name="ModeHighlight" Background="{DynamicResource AccentSoftBrush}" CornerRadius="10"
                                HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" Visibility="Hidden">
                            <Border.RenderTransform><TranslateTransform x:Name="ModeHighlightOffset"/></Border.RenderTransform>
                        </Border>
                        <StackPanel>
                    <RadioButton x:Name="WorkMode" GroupName="Mode" Style="{StaticResource SlidingModeButton}" Click="btnWork_Click" AutomationProperties.Name="Chế độ tập trung">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="&#xE916;" FontFamily="Segoe MDL2 Assets" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/><TextBlock Grid.Column="1" Text="Tập trung" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></Grid>
                    </RadioButton>
                    <RadioButton x:Name="RestMode" GroupName="Mode" Style="{StaticResource SlidingModeButton}" Click="btnRest_Click" AutomationProperties.Name="Chế độ nghỉ ngắn">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="&#xE708;" FontFamily="Segoe MDL2 Assets" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/><TextBlock Grid.Column="1" Text="Nghỉ ngắn" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></Grid>
                    </RadioButton>
                    <RadioButton x:Name="LongRestMode" GroupName="Mode" Style="{StaticResource SlidingModeButton}" Click="btnLongRest_Click" AutomationProperties.Name="Chế độ nghỉ dài">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="&#xE708;" FontFamily="Segoe MDL2 Assets" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/><TextBlock Grid.Column="1" Text="Nghỉ dài" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></Grid>
                    </RadioButton>
                        </StackPanel>
                    </Grid>
                    <music:MusicPlayerView x:Name="MusicPlayer" Margin="0,12,0,0" WallpaperSource="{Binding ElementName=WallpaperViewport}"/>
                </StackPanel>
                <StackPanel Grid.Row="3">
                    <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="12,20,12,24">
                        <StackPanel>
                            <TextBlock Text="Chậm lại để tiến xa." FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBlock Text="Tập trung từng phiên.&#x0a;Dành chỗ cho cả nghỉ ngơi." FontSize="12" Foreground="{DynamicResource MutedBrush}" LineHeight="20"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="TodoToggleButton" Content="☑   Công việc" Style="{StaticResource SecondaryButton}" Click="TodoToggle_Click" Margin="0,0,0,10" AutomationProperties.Name="Ẩn hoặc hiện danh sách công việc"/>
                    <Button Content="⚙   Cài đặt" Style="{StaticResource SecondaryButton}" Click="Button_Click" ToolTip="Cài đặt (Ctrl+,)" AutomationProperties.Name="Mở cài đặt"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Column="1" Margin="32,28,32,22">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Một việc tại một thời điểm." FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="Giữ nhịp tập trung, theo cách của bạn." Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="BackgroundNotice" Foreground="{DynamicResource ErrorBrush}" Visibility="Collapsed" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
            </Grid>
            <Frame Grid.Row="1" x:Name="frMain" NavigationUIVisibility="Hidden" Focusable="False" Background="Transparent" Margin="0,24,0,0"
                   controls:TimerDisplay.ToggleRequested="btnTimeControl_Click" controls:TimerDisplay.ResetRequested="Reset_Click"/>
            <Grid x:Name="CycleBackdrop" Grid.Row="2" SizeChanged="BackgroundLayout_SizeChanged">
                <background:WallpaperBackdrop x:Name="CycleBlurBackground" Source="{Binding ElementName=WallpaperViewport}"/>
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="20,16">
                <Grid>
                    <StackPanel><TextBlock Text="Nhịp tập trung" FontWeight="SemiBold"/><TextBlock x:Name="CycleText" Text="0 / 4 phiên hoàn thành" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0"/></StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Ellipse x:Name="Dot1" Width="12" Height="12" Fill="{DynamicResource LineBrush}" Margin="0,0,10,0"/>
                        <Ellipse x:Name="Dot2" Width="12" Height="12" Fill="{DynamicResource LineBrush}" Margin="0,0,10,0"/>
                        <Ellipse x:Name="Dot3" Width="12" Height="12" Fill="{DynamicResource LineBrush}" Margin="0,0,10,0"/>
                        <Ellipse x:Name="Dot4" Width="12" Height="12" Fill="{DynamicResource LineBrush}"/>
                    </StackPanel>
                </Grid>
                </Border>
            </Grid>
        </Grid>
        <Grid x:Name="TodoBackdrop" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Width="360" Height="540" Margin="0,96,0,0" SizeChanged="BackgroundLayout_SizeChanged">
            <background:WallpaperBackdrop x:Name="TodoBlurBackground" Source="{Binding ElementName=WallpaperViewport}"/>
            <Border CornerRadius="16,0,0,16" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,1,0,1">
                <todo:TodoListView x:Name="TodoList" CloseRequested="TodoClose_Requested"/>
            </Border>
        </Grid>
    </Grid>
</Window>

