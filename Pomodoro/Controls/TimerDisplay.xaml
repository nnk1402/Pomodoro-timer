<UserControl x:Class="Pomodoro.Controls.TimerDisplay"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:theme="clr-namespace:Pomodoro">
    <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><theme:ThemeResources/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
    <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
    <StackPanel Width="420" VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock x:Name="CaptionText" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,22"/>
        <Viewbox Stretch="Uniform" MaxWidth="310" MaxHeight="310" Margin="12,0">
            <Grid Width="310" Height="310">
                <Ellipse Stroke="{DynamicResource TrackBrush}" StrokeThickness="7" Margin="5"/>
                <Path x:Name="ProgressArc" Stroke="{DynamicResource AccentBrush}" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TimeText" Text="25:00" FontSize="72" FontWeight="Light" HorizontalAlignment="Center" FontFamily="Segoe UI" Typography.NumeralAlignment="Tabular"/>
                    <TextBlock x:Name="StateText" Text="Sẵn sàng bắt đầu" FontSize="14" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
                <Ellipse Width="10" Height="10" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Top" Margin="0,3,0,0"/>
            </Grid>
        </Viewbox>
        <TextBlock x:Name="DetailText" Foreground="{DynamicResource MutedBrush}" FontSize="14" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360" Margin="16,22,16,0"/>
    </StackPanel>
    </Viewbox>
</UserControl>
