<UserControl x:Class="Pomodoro.Features.Music.MusicPlayerView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:theme="clr-namespace:Pomodoro.Themes"
 xmlns:background="clr-namespace:Pomodoro.Features.Background"
 xmlns:local="clr-namespace:Pomodoro.Features.Music" UseLayoutRounding="True"
 theme:WallpaperText.SuppressShadow="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><theme:ThemeResources WallpaperAware="True"/></ResourceDictionary.MergedDictionaries>
            <Geometry x:Key="PlusGeometry">M 1,6 L 11,6 M 6,1 L 6,11</Geometry>
            <Geometry x:Key="RepeatGeometry">M 2,6 C 2,3 4,2 7,2 L 15,2 M 12,0 L 15,2 L 12,5 M 16,10 C 16,13 14,14 11,14 L 3,14 M 6,11 L 3,14 L 6,16</Geometry>
            <Geometry x:Key="PlayGeometry">M 0,0 L 0,14 L 11,7 Z</Geometry>
            <Geometry x:Key="PauseGeometry">M 0,0 L 4,0 L 4,14 L 0,14 Z M 8,0 L 12,0 L 12,14 L 8,14 Z</Geometry>
            <Style x:Key="MusicIcon" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                <Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="28"/>
                <Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource LineBrush}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value></Setter>
            </Style>
            <Style x:Key="MusicPlay" TargetType="Button" BasedOn="{StaticResource MusicIcon}">
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="20">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate></Setter.Value></Setter>
            </Style>
            <Style x:Key="MusicModeButton" TargetType="Button" BasedOn="{StaticResource MusicIcon}">
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                    <Border Background="Transparent" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate></Setter.Value></Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.85"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.65"/></Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="MusicListItem" TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
                <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Row" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="8" BorderThickness="1" BorderBrush="Transparent">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource LineBrush}"/></Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value></Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid x:Name="MiniPlayer" SizeChanged="MiniPlayer_SizeChanged" ToolTip="Thêm MP3 để nghe trong lúc tập trung">
            <background:WallpaperBackdrop Source="{Binding WallpaperSource, RelativeSource={RelativeSource AncestorType=local:MusicPlayerView}}"/>
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="9,12">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
                    <Button x:Name="PlayButton" Style="{StaticResource MusicPlay}" Width="38" Height="38" Click="Play_Click"
                            VerticalAlignment="Center" ToolTip="Phát nhạc" AutomationProperties.Name="Phát nhạc">
                        <Path x:Name="PlayIcon" Data="{StaticResource PlayGeometry}" Fill="{DynamicResource AccentInkBrush}" Stretch="Uniform" Width="12" Height="14"/>
                    </Button>
                    <Grid Grid.Column="1" Margin="8,0,7,0">
                        <Grid.RowDefinitions><RowDefinition Height="20"/><RowDefinition Height="26"/></Grid.RowDefinitions>
                        <Canvas x:Name="TitleViewport" ClipToBounds="True" SizeChanged="TitleViewport_SizeChanged">
                            <TextBlock x:Name="TrackTitle" Text="Thêm nhạc" FontSize="12" FontWeight="SemiBold">
                                <TextBlock.RenderTransform><TranslateTransform x:Name="TitleOffset"/></TextBlock.RenderTransform>
                            </TextBlock>
                        </Canvas>
                        <local:SpectrumView x:Name="Spectrum" Grid.Row="1" Foreground="{DynamicResource AccentInkBrush}" IsHitTestVisible="False"/>
                    </Grid>
                    <Button x:Name="LibraryButton" Grid.Column="2" Style="{StaticResource MusicIcon}" Width="28" Height="28" VerticalAlignment="Center"
                            Click="Library_Click" ToolTip="Mở Music list" AutomationProperties.Name="Mở danh sách và thêm nhạc">
                        <Path Data="{StaticResource PlusGeometry}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Width="12" Height="12" Stretch="Uniform"/>
                    </Button>
                </Grid>
            </Border>
        </Grid>
        <Popup x:Name="LibraryPopup" PlacementTarget="{Binding ElementName=MiniPlayer}" Placement="Right" HorizontalOffset="12"
               AllowsTransparency="True" StaysOpen="False" Opened="Library_Opened" Closed="Library_Closed">
            <Border x:Name="LibraryPanel" Width="410" Padding="20" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource LineBrush}"
                    Background="{DynamicResource SurfaceBrush}" PreviewKeyDown="Library_PreviewKeyDown"
                    theme:WallpaperText.SuppressShadow="True">
                <Border.Resources>
                    <ResourceDictionary><ResourceDictionary.MergedDictionaries><theme:ThemeResources/></ResourceDictionary.MergedDictionaries></ResourceDictionary>
                </Border.Resources>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Music list" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Grid x:Name="PlaybackModeNavigation" Grid.Column="1" Margin="4,0,10,0" SizeChanged="PlaybackModeNavigation_SizeChanged">
                            <Border x:Name="PlaybackModeHighlight" Background="{DynamicResource AccentSoftBrush}" CornerRadius="8"
                                    Width="30" Height="30" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Hidden" IsHitTestVisible="False">
                                <Border.RenderTransform><TranslateTransform x:Name="PlaybackModeOffset"/></Border.RenderTransform>
                            </Border>
                            <StackPanel Orientation="Horizontal">
                            <Button x:Name="RepeatOneButton" Style="{StaticResource MusicModeButton}" Width="30" Height="30" Margin="0,0,3,0" BorderThickness="0"
                                    Tag="{x:Static local:MusicPlayMode.RepeatOne}" Click="PlayMode_Click" ToolTip="Lặp lại một bài" AutomationProperties.Name="Lặp lại một bài">
                                <Grid Width="18" Height="18"><Path Data="{StaticResource RepeatGeometry}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Stretch="Uniform"/>
                                    <Path Data="M 7,7 L 9,5.5 L 9,12.5 M 7,12.5 L 11,12.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="18" Height="18" Stretch="None"/>
                                </Grid>
                            </Button>
                            <Button x:Name="RepeatAllButton" Style="{StaticResource MusicModeButton}" Width="30" Height="30" Margin="0,0,3,0" BorderThickness="0"
                                    Tag="{x:Static local:MusicPlayMode.RepeatAll}" Click="PlayMode_Click" ToolTip="Lặp lại danh sách" AutomationProperties.Name="Lặp lại danh sách">
                                <Path Data="{StaticResource RepeatGeometry}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Stretch="Uniform" Width="18" Height="18"/>
                            </Button>
                            <Button x:Name="ShuffleButton" Style="{StaticResource MusicModeButton}" Width="30" Height="30" BorderThickness="0"
                                    Tag="{x:Static local:MusicPlayMode.Shuffle}" Click="PlayMode_Click" ToolTip="Phát ngẫu nhiên" AutomationProperties.Name="Phát ngẫu nhiên">
                                <Path Data="M 1,3 L 4,3 C 8,3 10,15 14,15 L 18,15 M 15,12 L 18,15 L 15,18 M 1,15 L 4,15 C 8,15 10,3 14,3 L 18,3 M 15,0 L 18,3 L 15,6" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Stretch="Uniform" Width="18" Height="18"/>
                            </Button>
                            </StackPanel>
                        </Grid>
                        <Button x:Name="AddMusicButton" Grid.Column="2" Style="{StaticResource MusicPlay}" Width="30" Height="30" Click="AddMusic_Click"
                                Background="{DynamicResource AccentSoftBrush}" BorderThickness="0" ToolTip="Thêm nhạc MP3" AutomationProperties.Name="Thêm nhạc MP3">
                            <Path Data="{StaticResource PlusGeometry}" Stroke="{DynamicResource InkBrush}" StrokeThickness="1.6" Width="12" Height="12" Stretch="Uniform"/>
                        </Button>
                    </Grid>
                    <TextBlock x:Name="TrackCount" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,10"/>
                    <ListBox x:Name="TrackList" MaxHeight="288" MinHeight="80" BorderThickness="0" Background="Transparent" Padding="0"
                             ItemContainerStyle="{StaticResource MusicListItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False" VirtualizingPanel.IsVirtualizing="False"
                             AutomationProperties.Name="Danh sách bài nhạc" PreviewKeyDown="TrackList_PreviewKeyDown">
                        <ListBox.ItemTemplate><DataTemplate>
                            <Border x:Name="TrackCard" CornerRadius="8" Padding="10" Background="{DynamicResource HoverBrush}"
                                    Focusable="True" PreviewMouseLeftButtonDown="Row_MouseDown" MouseMove="Row_MouseMove"
                                    MouseLeftButtonUp="Row_MouseUp" LostMouseCapture="Row_LostCapture" KeyDown="Row_KeyDown"
                                    AutomationProperties.HelpText="Kéo để sắp xếp, hoặc dùng Alt và phím lên xuống">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
                                    <Button Style="{StaticResource MusicPlay}" Width="32" Height="32" VerticalAlignment="Center" Click="Track_Click" Tag="{Binding}"
                                            ToolTip="Phát / tạm dừng" AutomationProperties.Name="{Binding DisplayName}">
                                        <Path x:Name="RowPlayIcon" Data="{StaticResource PlayGeometry}" Width="11" Height="13" Stretch="Uniform" Fill="{DynamicResource InkBrush}"/>
                                    </Button>
                                    <Grid Grid.Column="1" Margin="9,0,8,0" ToolTip="{Binding FilePath}" Background="Transparent">
                                        <Grid.RowDefinitions><RowDefinition Height="22"/><RowDefinition Height="20"/></Grid.RowDefinitions>
                                        <local:MarqueeText Text="{Binding DisplayName}" Foreground="{DynamicResource InkBrush}" FontSize="13" FontWeight="SemiBold"/>
                                        <local:SpectrumView x:Name="RowSpectrum" Grid.Row="1" Foreground="{DynamicResource AccentInkBrush}" Opacity="0.35" IsHitTestVisible="False" Loaded="RowSpectrum_Loaded" Unloaded="RowSpectrum_Unloaded"/>
                                    </Grid>
                                    <Button Grid.Column="2" Style="{StaticResource MusicIcon}" BorderThickness="0" Tag="{Binding}" Click="RemoveTrack_Click"
                                            Width="28" Height="28" ToolTip="Bỏ khỏi danh sách" AutomationProperties.Name="Bỏ bài nhạc khỏi danh sách">
                                        <Path Data="M 2,4 L 14,4 M 6,4 L 6,2 L 10,2 L 10,4 M 4,4 L 5,15 L 11,15 L 12,4 M 7,7 L 7,12 M 9,7 L 9,12" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.4" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="16" Stretch="Uniform"/>
                                    </Button>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter TargetName="TrackCard" Property="Background" Value="{DynamicResource AccentSoftBrush}"/></DataTrigger>
                                <DataTrigger Binding="{Binding IsPlaying}" Value="True"><Setter TargetName="RowPlayIcon" Property="Data" Value="{StaticResource PauseGeometry}"/><Setter TargetName="RowSpectrum" Property="Opacity" Value="1"/></DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="EmptyNotice" Text="Thêm nhạc bằng nút + phía trên để bắt đầu." TextWrapping="Wrap"
                               FontSize="13" Foreground="{DynamicResource MutedBrush}" Margin="4,0,4,16"/>
                    <TextBlock x:Name="LibraryNotice" Visibility="Collapsed" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource ErrorBrush}"
                               Margin="0,8,0,8" AutomationProperties.LiveSetting="Polite"/>
                    <TextBlock Text="Giữ và kéo bài nhạc để sắp xếp" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="2,8,0,0"/>
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Popup>
    </Grid>
</UserControl>
