<UserControl x:Class="Pomodoro.Features.Timer.Controls.TimerDisplay"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:theme="clr-namespace:Pomodoro.Themes">
    <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><theme:ThemeResources WallpaperAware="True"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
    <Grid>
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
    <StackPanel Width="420" VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock x:Name="CaptionText" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,22"/>
        <Viewbox Stretch="Uniform" MaxWidth="310" MaxHeight="310" Margin="12,0">
            <Grid Width="310" Height="310">
                <Ellipse Stroke="{DynamicResource TrackBrush}" StrokeThickness="7" Margin="5"/>
                <Path x:Name="ProgressArc" Stroke="{DynamicResource AccentBrush}" StrokeThickness="10" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TimeText" FontWeight="Bold" Text="25:00" FontSize="72" HorizontalAlignment="Center" FontFamily="Segoe UI" Typography.NumeralAlignment="Tabular" Effect="{DynamicResource WallpaperTimerShadow}"/>
                    <TextBlock x:Name="StateText" Text="Sẵn sàng bắt đầu" FontSize="14" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
                <Ellipse Width="10" Height="10" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Top" Margin="0,3,0,0"/>
            </Grid>
        </Viewbox>
        <TextBlock x:Name="DetailText" Foreground="{DynamicResource MutedBrush}" FontSize="14" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360" Margin="16,22,16,0"/>
    </StackPanel>
    </Viewbox>
    <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,6,0,26">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="ResetButton" Content="↺" FontSize="22" Padding="15,8" Style="{StaticResource SecondaryButton}" Click="Reset_Click" Margin="0,0,10,0" ToolTip="Bắt đầu lại phiên (Ctrl+R)" AutomationProperties.Name="Bắt đầu lại phiên"/>
            <Button x:Name="ControlTimeButton" Content="▶   Bắt đầu" Style="{StaticResource PrimaryButton}" Click="Toggle_Click" ToolTip="Bắt đầu hoặc tạm dừng (Space)"/>
        </StackPanel>
        <TextBlock x:Name="NextText" Foreground="{DynamicResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap" FontSize="12" Margin="0,16,0,0"/>
    </StackPanel>
    </Grid>
</UserControl>
