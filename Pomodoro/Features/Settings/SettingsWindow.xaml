<Window x:Class="Pomodoro.Features.Settings.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:theme="clr-namespace:Pomodoro.Themes"
 Title="Cài đặt · Pomodoro" Width="580" Height="760" MinWidth="500" MinHeight="480" WindowStartupLocation="CenterOwner" Background="{DynamicResource CanvasBrush}" FontFamily="Segoe UI" FontSize="14" theme:KeyboardFocusFeedback.Enabled="True">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><theme:ThemeResources/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,24">
            <TextBlock Text="Nhịp làm việc của bạn" FontSize="25" FontWeight="SemiBold"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,8,8">
                <TextBlock Text="Giao diện" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="Chọn ánh sáng phù hợp với không gian của bạn." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,6,0,14" TextWrapping="Wrap"/>
                <UniformGrid Columns="3" Margin="0,0,0,18">
                    <RadioButton x:Name="LightTheme" GroupName="Theme" Style="{StaticResource ModeButton}" Padding="10,12" Checked="Theme_Checked" AutomationProperties.Name="Giao diện sáng">
                        <TextBlock Text="☀  Sáng" HorizontalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                    </RadioButton>
                    <RadioButton x:Name="DarkTheme" GroupName="Theme" Style="{StaticResource ModeButton}" Padding="10,12" Checked="Theme_Checked" AutomationProperties.Name="Giao diện tối">
                        <TextBlock Text="☾  Tối" HorizontalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                    </RadioButton>
                    <RadioButton x:Name="SystemTheme" GroupName="Theme" Style="{StaticResource ModeButton}" Padding="10,12" Checked="Theme_Checked" AutomationProperties.Name="Giao diện theo hệ thống">
                        <TextBlock Text="Hệ thống" HorizontalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                    </RadioButton>
                </UniformGrid>
                <TextBlock Text="Hình nền" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="Xem trước trực tiếp ở cửa sổ chính. Lưu để giữ thay đổi, Hủy để khôi phục." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,6,0,12" TextWrapping="Wrap"/>
                <UniformGrid Columns="3">
                    <RadioButton x:Name="DefaultBackground" GroupName="Background" Content="Mặc định" Style="{StaticResource ModeButton}" Padding="10,12" Checked="Background_Checked"/>
                    <RadioButton x:Name="ImageBackground" GroupName="Background" Content="Ảnh tĩnh" Style="{StaticResource ModeButton}" Padding="10,12" Checked="Background_Checked"/>
                    <RadioButton x:Name="VideoBackground" GroupName="Background" Content="Video" Style="{StaticResource ModeButton}" Padding="10,12" Checked="Background_Checked"/>
                </UniformGrid>
                <Grid Margin="0,2,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="BackgroundPathText" IsReadOnly="True" FontSize="12" Margin="0,0,10,0" AutomationProperties.Name="Tệp hình nền" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    <Button x:Name="ChooseBackgroundButton" Grid.Column="1" Content="Chọn tệp…" Style="{StaticResource SecondaryButton}" Click="ChooseBackground_Click" Padding="14,10"/>
                </Grid>
                <TextBlock x:Name="BackgroundStatus" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
                <Grid x:Name="BackgroundAdjustments" Margin="0,12,0,20">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Label Content="Độ tối hình nền" Target="{Binding ElementName=DarknessSlider}" Foreground="{DynamicResource InkBrush}" Padding="0,0,0,8"/>
                    <TextBlock Grid.Column="1" Text="{Binding Value, ElementName=DarknessSlider, StringFormat={}{0:0}%}" HorizontalAlignment="Right"/>
                    <Slider x:Name="DarknessSlider" Grid.Row="1" Grid.ColumnSpan="2" Minimum="0" Maximum="85" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="BackgroundDisplay_Changed" AutomationProperties.Name="Độ tối hình nền"/>
                    <Label Grid.Row="2" Content="Độ đậm nền component" Target="{Binding ElementName=SurfaceSlider}" Foreground="{DynamicResource InkBrush}" Padding="0,14,0,8"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Value, ElementName=SurfaceSlider, StringFormat={}{0:0}%}" HorizontalAlignment="Right" Margin="0,14,0,0"/>
                    <Slider x:Name="SurfaceSlider" Grid.Row="3" Grid.ColumnSpan="2" Minimum="0" Maximum="80" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="BackgroundDisplay_Changed" AutomationProperties.Name="Độ đậm nền component"/>
                </Grid>
                <TextBlock Text="Thời lượng mỗi phiên" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="Biết mình biết ta, trăm trận trăm thắng." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,6,0,18" TextWrapping="Wrap"/>
                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="18">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="100"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Label Content="_Tập trung" Target="{Binding ElementName=WorkTimeTextBox}" VerticalAlignment="Center" Foreground="{DynamicResource InkBrush}"/>
                        <TextBox x:Name="WorkTimeTextBox" Grid.Column="1" AutomationProperties.Name="Thời gian tập trung" MaxLength="3"/>
                        <TextBlock Grid.Column="2" Text="phút" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        <Label Grid.Row="1" Content="Nghỉ _ngắn" Target="{Binding ElementName=RestTimeTextBox}" VerticalAlignment="Center" Margin="0,14,0,0" Foreground="{DynamicResource InkBrush}"/>
                        <TextBox x:Name="RestTimeTextBox" Grid.Row="1" Grid.Column="1" Margin="0,14,0,0" AutomationProperties.Name="Thời gian nghỉ ngắn" MaxLength="3"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="phút" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="10,14,0,0"/>
                        <Label Grid.Row="2" Content="Nghỉ _dài" Target="{Binding ElementName=LongRestTimeTextBox}" VerticalAlignment="Center" Margin="0,14,0,0" Foreground="{DynamicResource InkBrush}"/>
                        <TextBox x:Name="LongRestTimeTextBox" Grid.Row="2" Grid.Column="1" Margin="0,14,0,0" AutomationProperties.Name="Thời gian nghỉ dài" MaxLength="3"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="phút" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="10,14,0,0"/>
                    </Grid>
                </Border>
                <TextBlock Text="Âm thanh kết thúc" FontSize="16" FontWeight="SemiBold" Margin="0,24,0,12"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="RingtonePathTextBox" IsReadOnly="True" FontSize="13" Margin="0,0,10,0" AutomationProperties.Name="Nhạc chuông đã chọn" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    <Button Grid.Column="1" Content="Chọn MP3" Style="{StaticResource SecondaryButton}" Click="ChooseRingtoneButton_Click"/>
                </Grid>
                <TextBlock Text="Giữ tệp nhạc ở vị trí đã chọn để dùng cho lần mở sau." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Margin="0,16,0,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive"/>
            </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button Content="Mặc định" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="setDefaultButton_Click" Padding="14,10"/>
            <Button Grid.Column="1" Content="Hủy" Style="{StaticResource SecondaryButton}" IsCancel="True" Margin="0,0,10,0" Padding="18,10"/>
            <Button x:Name="SaveSettingsButton" Grid.Column="2" Content="Lưu cài đặt" Style="{StaticResource PrimaryButton}" MinWidth="130" Click="SaveButton_Click" IsDefault="True" Padding="16,10"/>
        </Grid>
    </Grid>
</Window>

