<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Assets\Sounds\alarm_sound.m4a" />
    <None Remove="Assets\Sounds\alarm_sound.mp3" />
    <None Remove="Assets\Images\breaktimeWallpaper.jpg" />
    <None Remove="Assets\Images\longRestBackground.png" />
    <None Remove="Assets\Images\mainmenu.png" />
    <None Remove="Assets\Images\studyTime.jpg" />
    <None Remove="Assets\Images\timeUpBackground.jpg" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\Sounds\alarm_sound.mp3">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Images\breaktimeWallpaper.jpg" />
    <Resource Include="Assets\Images\longRestBackground.png" />
    <Resource Include="Assets\Images\mainmenu.png" />
    <Resource Include="Assets\Images\studyTime.jpg" />
    <Resource Include="Assets\Images\timeUpBackground.jpg" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Assets\Sounds\CurrentAlarm\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

</Project>
