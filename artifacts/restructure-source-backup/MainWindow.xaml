<Window x:Class="Pomodoro.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:theme="clr-namespace:Pomodoro" xmlns:controls="clr-namespace:Pomodoro.Controls"
 Title="Pomodoro · Không gian tập trung" Width="1120" Height="800" MinWidth="820" MinHeight="700" WindowStartupLocation="CenterScreen"
 Background="{DynamicResource CanvasBrush}" FontFamily="Segoe UI" FontSize="14" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><theme:ThemeResources WallpaperAware="True"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid SizeChanged="BackgroundLayout_SizeChanged">
        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid Grid.ColumnSpan="2" ClipToBounds="True" IsHitTestVisible="False">
            <Image x:Name="WallpaperImage" Stretch="UniformToFill"/>
            <Rectangle x:Name="WallpaperShade" Fill="Black" Opacity="0"/>
        </Grid>
        <Border Grid.Column="1" Background="{DynamicResource ContentBackdropBrush}"/>
        <!-- Blur only the shared wallpaper behind the sidebar; keep its content sharp. -->
        <Grid Grid.Column="0" ClipToBounds="True" IsHitTestVisible="False">
            <Image Source="{Binding Source, ElementName=WallpaperImage}"
                   Width="{Binding ActualWidth, ElementName=WallpaperImage}"
                   Height="{Binding ActualHeight, ElementName=WallpaperImage}"
                   HorizontalAlignment="Left" VerticalAlignment="Top" Stretch="UniformToFill">
                <Image.Effect>
                    <BlurEffect Radius="16" KernelType="Gaussian" RenderingBias="Performance"/>
                </Image.Effect>
            </Image>
            <Rectangle Fill="Black" Opacity="{Binding Opacity, ElementName=WallpaperShade}"/>
        </Grid>
        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="20,30,20,24">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="10,0,0,40">
                    <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource AccentBrush}" Margin="0,0,10,0">
                        <Grid><Ellipse Stroke="{DynamicResource OnAccentBrush}" StrokeThickness="1.6" Width="19" Height="19"/><Path Data="M 17,10 L 17,17 L 22,17" Stroke="{DynamicResource OnAccentBrush}" StrokeThickness="1.6" StrokeLineJoin="Round"/></Grid>
                    </Border>
                    <TextBlock Text="pomodoro" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Row="1">
                    <TextBlock Text="Không gian của bạn" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="16,0,0,14"/>
                    <RadioButton x:Name="WorkMode" GroupName="Mode" Style="{StaticResource ModeButton}" Click="btnWork_Click" AutomationProperties.Name="Chế độ tập trung">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="&#xE916;" FontFamily="Segoe MDL2 Assets" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/><TextBlock Grid.Column="1" Text="Tập trung" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></Grid>
                    </RadioButton>
                    <RadioButton x:Name="RestMode" GroupName="Mode" Style="{StaticResource ModeButton}" Click="btnRest_Click" AutomationProperties.Name="Chế độ nghỉ ngắn">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="&#xE708;" FontFamily="Segoe MDL2 Assets" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/><TextBlock Grid.Column="1" Text="Nghỉ ngắn" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></Grid>
                    </RadioButton>
                    <RadioButton x:Name="LongRestMode" GroupName="Mode" Style="{StaticResource ModeButton}" Click="btnLongRest_Click" AutomationProperties.Name="Chế độ nghỉ dài">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="&#xE708;" FontFamily="Segoe MDL2 Assets" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/><TextBlock Grid.Column="1" Text="Nghỉ dài" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></Grid>
                    </RadioButton>
                </StackPanel>
                <StackPanel Grid.Row="3">
                    <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="12,20,12,24">
                        <StackPanel>
                            <TextBlock Text="Chậm lại để tiến xa." FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBlock Text="Tập trung từng phiên.&#x0a;Dành chỗ cho cả nghỉ ngơi." FontSize="12" Foreground="{DynamicResource MutedBrush}" LineHeight="20"/>
                        </StackPanel>
                    </Border>
                    <Button Content="⚙   Cài đặt" Style="{StaticResource SecondaryButton}" Click="Button_Click" ToolTip="Cài đặt (Ctrl+,)" AutomationProperties.Name="Mở cài đặt"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Column="1" Margin="32,28,32,22">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Một việc tại một thời điểm." FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="Giữ nhịp tập trung, theo cách của bạn." Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="BackgroundNotice" Foreground="{DynamicResource ErrorBrush}" Visibility="Collapsed" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
                <Border Grid.Column="1" Background="{DynamicResource AccentSoftBrush}" CornerRadius="12" Padding="12,6" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock x:Name="StatusText" Text="Sẵn sàng" Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="SemiBold"/>
                </Border>
            </Grid>
            <Frame Grid.Row="1" x:Name="frMain" NavigationUIVisibility="Hidden" Focusable="False" Background="Transparent" Margin="0,24,0,0"
                   controls:TimerDisplay.ToggleRequested="btnTimeControl_Click" controls:TimerDisplay.ResetRequested="Reset_Click"/>
            <Grid x:Name="CycleBackdrop" Grid.Row="2" SizeChanged="BackgroundLayout_SizeChanged">
                <!-- Share the existing video source; blur only its background pixels. -->
                <Canvas IsHitTestVisible="False">
                    <Image x:Name="CycleBlurImage" Source="{Binding Source, ElementName=WallpaperImage}"
                           Width="{Binding ActualWidth, ElementName=WallpaperImage}"
                           Height="{Binding ActualHeight, ElementName=WallpaperImage}" Stretch="UniformToFill">
                        <Image.Effect>
                            <BlurEffect Radius="16" KernelType="Gaussian" RenderingBias="Performance"/>
                        </Image.Effect>
                    </Image>
                </Canvas>
                <Rectangle Fill="Black" Opacity="{Binding Opacity, ElementName=WallpaperShade}" IsHitTestVisible="False"/>
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="20,16">
                <Grid>
                    <StackPanel><TextBlock Text="Nhịp tập trung" FontWeight="SemiBold"/><TextBlock x:Name="CycleText" Text="0 / 4 phiên hoàn thành" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0"/></StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Ellipse x:Name="Dot1" Width="12" Height="12" Fill="{DynamicResource LineBrush}" Margin="0,0,10,0"/>
                        <Ellipse x:Name="Dot2" Width="12" Height="12" Fill="{DynamicResource LineBrush}" Margin="0,0,10,0"/>
                        <Ellipse x:Name="Dot3" Width="12" Height="12" Fill="{DynamicResource LineBrush}" Margin="0,0,10,0"/>
                        <Ellipse x:Name="Dot4" Width="12" Height="12" Fill="{DynamicResource LineBrush}"/>
                    </StackPanel>
                </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>

